---
import Layout from '../../layouts/Layout.astro';
import { getPosts, type BlogPost } from '../../lib/microcms';
export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const post = Astro.props.post as BlogPost;
const formatDate = (value: string) =>
	new Intl.DateTimeFormat('ja-JP', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	}).format(new Date(value));
const site = Astro.site || new URL('https://tokiolab.dev');
const canonicalUrl = new URL(Astro.url.pathname, site).href;
const structuredData = {
	'@type': 'BlogPosting',
	'@id': `${canonicalUrl}#article`,
	headline: post.title,
	description: post.excerpt || post.title,
	datePublished: post.publishedAt,
	dateModified: post.updatedAt,
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': canonicalUrl,
	},
	isPartOf: { '@id': `${site.href}#website` },
	inLanguage: 'ja-JP',
	...(post.eyecatch ? { image: post.eyecatch.url } : {}),
};
---

<Layout
	title={`${post.title} | TOKIOLAB`}
	description={post.excerpt || post.title}
	ogImage={post.eyecatch?.url || undefined}
	structuredData={structuredData}
>
	<main class="page">
		<article class="article">
			<p class="back">
				<a href="/">← 記事一覧</a>
			</p>
			<p class="meta">
				{post.category && (
					<a class="category" href={`/categories/${post.category.id}/`}>
						{post.category.name}
					</a>
				)}
				<time datetime={post.publishedAt}>
					公開 {formatDate(post.publishedAt)}
				</time>
				<time class="updated-at" datetime={post.updatedAt}>
					<svg aria-hidden="true" viewBox="0 0 24 24">
						<path d="M21 12a9 9 0 0 0-15.5-6.4L3 8" />
						<path d="M3 2v6h6" />
						<path d="M3 12a9 9 0 0 0 15.5 6.4L21 16" />
						<path d="M21 22v-6h-6" />
					</svg>
					更新 {formatDate(post.updatedAt)}
				</time>
			</p>
			<h1>{post.title}</h1>
			<ul class="tag-list" aria-label="タグ">
				{post.tags.map((tag) => (
					<li>
						<a href={`/tags/${tag.id}/`}>#{tag.name}</a>
					</li>
				))}
			</ul>
			{post.eyecatch && (
				<img
					src={post.eyecatch.url}
					alt={post.eyecatch.alt || ''}
					width={post.eyecatch.width}
					height={post.eyecatch.height}
				/>
			)}
			<div class="content" set:html={post.content} />
		</article>
	</main>
</Layout>

<style>
	.article {
		max-width: 720px;
	}
	.back {
		margin: 0 0 28px;
		font-size: 0.82rem;
	}
	.back a {
		text-decoration: none;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 12px;
		margin: 0 0 12px;
		color: var(--color-muted);
		font-size: 0.78rem;
	}
	.updated-at {
		display: inline-flex;
		align-items: center;
		gap: 3px;
	}
	.updated-at svg {
		width: 0.9em;
		height: 0.9em;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
	}
	.category {
		color: var(--color-accent);
		font-weight: 600;
		text-decoration: none;
	}
	h1 {
		margin: 0;
		font-size: clamp(1.8rem, 4vw, 3rem);
		letter-spacing: -0.05em;
		line-height: 1.25;
	}
	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 12px;
		margin: 18px 0 36px;
		padding: 0;
		color: var(--color-muted);
		font-size: 0.78rem;
		list-style: none;
	}
	.tag-list a {
		text-decoration: none;
	}
	img {
		display: block;
		max-width: 100%;
		height: auto;
		margin: 0 0 40px;
	}
	.content {
		font-size: 1rem;
	}
	.content :global(h2) {
		margin: 48px 0 14px;
		font-size: 1.35rem;
		letter-spacing: -0.025em;
		line-height: 1.4;
	}
	.content :global(h3) {
		margin-top: 36px;
		font-size: 1.1rem;
	}
	.content :global(a) {
		color: var(--color-accent);
	}
	.content :global(blockquote) {
		margin: 28px 0;
		padding-left: 1em;
		border-left: 3px solid var(--color-line);
		color: var(--color-muted);
	}
	.content :global(blockquote p) {
		margin: 0;
	}
	.content :global(blockquote p + p) {
		margin-top: 1em;
	}
	.content :global(img) {
		max-width: 100%;
		height: auto;
	}
	.content :global(code) {
		padding: 0.15em 0.4em;
		border-radius: 4px;
		background: var(--color-line);
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.85em;
	}
	.content :global(pre) {
		overflow-x: auto;
		margin: 28px 0;
		padding: 18px 20px;
		border-radius: 8px;
		background: var(--color-ink);
		color: var(--color-paper);
		font-size: 0.85rem;
		line-height: 1.7;
	}
	.content :global(pre code) {
		padding: 0;
		border-radius: 0;
		background: transparent;
		color: inherit;
		font-size: inherit;
	}
	.content :global([data-filename]) {
		margin: 28px 0;
	}
	.content :global([data-filename]::before) {
		display: block;
		padding: 7px 12px;
		border-radius: 8px 8px 0 0;
		background: var(--color-line);
		color: var(--color-muted);
		content: attr(data-filename);
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.75rem;
	}
	.content :global([data-filename] pre) {
		margin-top: 0;
		border-radius: 0 0 8px 8px;
	}
	.content :global(table) {
		display: table;
		width: 100%;
		max-width: 100%;
		margin: 28px 0;
		border: 1px solid #c7c3bc;
		border-collapse: collapse;
		background: #fff;
		font-size: 0.9rem;
	}
	.content :global(th),
	.content :global(td) {
		min-width: 120px;
		padding: 10px 12px;
		text-align: left;
		vertical-align: top;
	}
	.content :global(tr > :not(:last-child)) {
		border-right: 1px solid #d7d3cb;
	}
	.content :global(tr:not(:last-child) > *) {
		border-bottom: 1px solid #d7d3cb;
	}
	.content :global(th) {
		background: #e8e4dc;
		font-weight: 650;
	}
	.content :global(tbody tr:nth-child(odd) td) {
		background: #fbfaf8;
	}
	.content :global(th p),
	.content :global(td p) {
		margin: 0;
	}
</style>
