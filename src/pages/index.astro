---
import Layout from '../layouts/Layout.astro';
import { getContentPreview, getPostCount, getPosts } from '../lib/microcms';
const [posts, postCount] = await Promise.all([getPosts(), getPostCount()]);
const formatDate = (value: string) =>
	new Intl.DateTimeFormat('ja-JP', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	}).format(new Date(value));
---

<Layout title="TOKIOLAB | ウェブとプロダクトの記録">
	<main class="page">
		<header class="site-intro">
			<h1>
				TOKIO LAB<span>.</span>
			</h1>
			<p>
				ウェブとプロダクトについて、つくりながら考えたことを記録しています。
			</p>
		</header>
		<div class="post-list-header">
			<h2>Articles</h2>
			<p class="post-count">
				<strong>{postCount}</strong> posts
			</p>
		</div>
		<ul class="post-list">
			{posts.map((post) => (
				<li class="post-item">
					<article>
						<div>
							<p class="post-meta">
								{post.category && (
									<a class="category" href={`/categories/${post.category.id}/`}>
										{post.category.name}
									</a>
								)}
								<time datetime={post.publishedAt}>
									公開 {formatDate(post.publishedAt)}
								</time>
								<time class="updated-at" datetime={post.updatedAt}>
									<svg aria-hidden="true" viewBox="0 0 24 24">
										<path d="M21 12a9 9 0 0 0-15.5-6.4L3 8" />
										<path d="M3 2v6h6" />
										<path d="M3 12a9 9 0 0 0 15.5 6.4L21 16" />
										<path d="M21 22v-6h-6" />
									</svg>
									更新 {formatDate(post.updatedAt)}
								</time>
							</p>
							<h2>
								<a href={`/blog/${post.id}/`}>{post.title}</a>
							</h2>
							{getContentPreview(post.content) && (
								<p class="description">{getContentPreview(post.content)}</p>
							)}
							<ul class="tag-list" aria-label="タグ">
								{post.tags.map((tag) => (
									<li>
										<a href={`/tags/${tag.id}/`}>#{tag.name}</a>
									</li>
								))}
							</ul>
						</div>
					</article>
				</li>
			))}
		</ul>
	</main>
</Layout>

<style>
	.site-intro {
		margin: 20px 0 72px;
		text-align: center;
	}
	.site-intro h1 {
		margin: 0;
		font-size: clamp(2rem, 6vw, 3rem);
		letter-spacing: 0.04em;
		line-height: 1.2;
	}
	.site-intro h1 span {
		color: var(--color-accent);
	}
	.site-intro p {
		max-width: 360px;
		margin: var(--space-4) auto 0;
		color: var(--color-muted);
		font-size: var(--font-size-small);
	}
	.post-list-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		padding-bottom: var(--space-3);
		border-bottom: 1px solid var(--color-line);
	}
	.post-list-header h2,
	.post-count {
		margin: 0;
		font-size: var(--font-size-meta);
	}
	.post-list-header h2 {
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.post-count {
		color: var(--color-muted);
	}
	.post-count strong {
		color: var(--color-accent);
		font-size: 1rem;
		font-weight: 700;
	}
	.post-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.post-item {
		padding: var(--space-5) 0;
		border-bottom: 1px solid var(--color-line);
	}
	.post-meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-3);
		margin: 0 0 var(--space-2);
		color: var(--color-muted);
		font-size: var(--font-size-meta);
	}
	.updated-at {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
	}
	.updated-at svg {
		width: 0.9em;
		height: 0.9em;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
	}
	.category {
		color: var(--color-accent);
		font-weight: 600;
		text-decoration: none;
	}
	h2 {
		margin: 0;
		font-size: clamp(1.1rem, 2vw, 1.35rem);
		font-weight: 650;
		letter-spacing: -0.025em;
		line-height: 1.45;
	}
	h2 a {
		text-decoration: none;
	}
	h2 a:hover {
		color: var(--color-accent);
	}
	.description {
		margin: var(--space-2) 0 0;
		color: var(--color-muted);
		font-size: var(--font-size-small);
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}
	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-3);
		margin: var(--space-3) 0 0;
		padding: 0;
		color: var(--color-muted);
		font-size: var(--font-size-meta);
		list-style: none;
	}
	.tag-list a {
		text-decoration: none;
	}
</style>
